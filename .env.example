# PixivFlow WebUI 后端（pixivflow webui API，端口默认 3000）。
# - Docker Desktop / macOS / Windows：默认 host.docker.internal 即可；
# - Linux：compose 已加 host-gateway 映射，默认同样可用；
# - 后端需监听 0.0.0.0（如 HOST=0.0.0.0），否则容器访问不到。
UPSTREAM_API=http://host.docker.internal:3000

# 前端对外端口（避开后端 3000 与 telepost API 8080）
WEBUI_PORT=3001
